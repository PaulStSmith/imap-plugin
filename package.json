{
  "name": "imap-plugin",
  "version": "0.5.0-beta.0",
  "description": "Hosted MCP server for generic IMAP mailboxes in Codex and compatible GPTs.",
  "type": "module",
  "main": "dist/server.js",
  "bin": {
    "imap-plugin": "dist/cli.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsx src/server.ts",
    "package:check": "npm run build && npm pack --dry-run",
    "azure:check-env": "node scripts/check-azure-env.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "start": "node dist/server.js"
  },
  "files": [
    ".codex-plugin/",
    ".mcp.json",
    "assets/",
    "commands/",
    "dist/",
    "docs/assets/",
    "docs/billing.js",
    "docs/index.html",
    "docs/privacy.html",
    "docs/styles.css",
    "docs/terms.html",
    "scripts/check-azure-env.mjs",
    "scripts/setup-local-iis.ps1",
    "scripts/start-setup-page.mjs",
    "web.config",
    "README.md"
  ],
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.17.3",
    "commander": "^12.1.0",
    "express": "^5.2.1",
    "html-to-text": "^9.0.5",
    "imapflow": "^1.0.191",
    "mailparser": "^3.7.2",
    "mssql": "^12.7.0",
    "zod": "^3.23.8",
    "zod-to-json-schema": "^3.25.1"
  },
  "optionalDependencies": {
    "keytar": "^7.9.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "@types/html-to-text": "^9.0.4",
    "@types/mailparser": "^3.4.6",
    "@types/mssql": "^12.3.0",
    "@types/node": "^22.5.5",
    "tsx": "^4.19.0",
    "typescript": "^5.5.4"
  },
  "engines": {
    "node": ">=20"
  },
  "license": "MIT"
}
